# GymCoach AI local env example — copy values into user-secrets or environment. Do not commit real keys.

JWT__SigningKey=REPLACE_WITH_LONG_RANDOM_SECRET
ConnectionStrings__Default=Host=localhost;Port=5432;Database=gymcoach;Username=gymcoach;Password=gymcoach
Database__UseInMemory=true

# Preferred OpenAI / OpenAI-compatible settings
OPENAI_API_KEY=REPLACE_ME
OPENAI_MODEL=gpt-4o-mini

OpenAI__Enabled=true
OpenAI__ApiKey=REPLACE_ME
OpenAI__Model=gpt-4o-mini
OpenAI__BaseUrl=https://api.openai.com/v1
OpenAI__TimeoutSeconds=30
OpenAI__MaxRetries=2

# Alternate Ai:* shape (also supported; AgentRouter-compatible BaseUrl)
Ai__Enabled=true
Ai__BaseUrl=https://api.openai.com/v1
Ai__Model=gpt-4o-mini
Ai__ApiKey=REPLACE_ME
Ai__TimeoutSeconds=30
Ai__MaxRetries=2
